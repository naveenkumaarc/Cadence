<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
  <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_art" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_cadence" android:contentDescription="Open Cadence" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="4dp">
      <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cadence" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose something to play" android:textColor="#B5BDB7" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
  </LinearLayout>
  <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="10dp" android:progressTint="#1ED760" android:progressBackgroundTint="#465049" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal" android:paddingTop="4dp">
    <ImageButton android:id="@+id/widget_back" android:layout_width="64dp" android:layout_height="48dp" android:src="@drawable/widget_previous" android:background="@android:color/transparent" android:contentDescription="Previous or rewind" />
    <ImageButton android:id="@+id/widget_play" android:layout_width="64dp" android:layout_height="48dp" android:src="@drawable/widget_play" android:background="@android:color/transparent" android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:src="@drawable/widget_next" android:background="@android:color/transparent" android:contentDescription="Next or fast forward" />
  </LinearLayout>
</LinearLayout>
